# Cold-start benchmark live-run output + isolated corpora (never commit)
benchmarks/cold_start_eval/runs/

# Raw gvf-run output under a codex_paper_eval run (SQLite DBs + per-layer
# artifacts, ~70MB per run). The scored summaries beside it ARE tracked:
# selection/LOCK/predictions/report/paper_metrics/evidence.
# Slashless twin: a trailing-slash pattern matches directories only, so a
# local production_runs SYMLINK (worktree convenience) would show untracked.
benchmarks/codex_paper_eval/runs/*/production_runs/
benchmarks/codex_paper_eval/runs/*/production_runs
benchmarks/codex_paper_eval/runs/*/diagnostics/**/production_runs/
benchmarks/codex_paper_eval/runs/*/diagnostics/**/production_runs
benchmarks/codex_paper_eval/runs/*/driver.log

# Human gold packets commit their protocol, roster hashes, manifests, and blank
# templates. Full-text paper copies and handoff ZIPs are source artifacts and
# stay local/custodial, especially for the never-tuned holdout split.
benchmarks/curated_extraction_eval/gold150_preregistered_*/**/papers/
benchmarks/curated_extraction_eval/gold150_preregistered_*/*.zip
benchmarks/curated_extraction_eval/gold150_preregistered_*/**/*.zip

# Consolidated source corpus (deduplicated full text + supplements + figures,
# multi-GB fetched source; discoverable via corpus/INDEX.{json,csv}, never commit).
# Slashless and anchored on purpose: locally `corpus` is an absolute symlink to
# external storage, and a trailing-slash pattern matches directories only — it
# would leave a recreated symlink showing as untracked in a fresh checkout.
/corpus

# Ad-hoc local recall debugging helpers
scripts/_analyze_missing.py
scripts/_inspect_missing.py

