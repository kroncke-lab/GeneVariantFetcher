    {
      "id": "gck-null",
      "title": "GCK’s 3D advantage over sequence is ordinary under the conditional null",
      "queries": [
        {
          "id": "conditional-permutations",
          "source": {
            "label": "GCK frozen-weight permutation diagnostic",
            "files": [
              {
                "label": "permutation_summary.csv"
              },
              {
                "label": "gck/checks.json"
              }
            ],
            "caveats": [
              "This is an exploratory internal diagnostic against posterior-derived labels, not independent clinical validation. It does not show that all spatial association disappears."
            ],
            "filters": [
              "614 geometry-supported target positions",
              "Count bins: 1, 2, 3–5, 6–10, >10",
              "2,000 seeded permutations within 14 origin/count strata"
            ]
          },
          "summary": "For posterior labels, the 3D-over-sequence MSE gain is 0.001169; the origin-and-count-bin conditional null gives p=0.474263.",
          "columns": [
            {
              "field": "labels",
              "label": "Evaluation label"
            },
            {
              "field": "observed_gain",
              "label": "Observed MSE gain"
            },
            {
              "field": "null_mean_gain",
              "label": "Mean null gain"
            },
            {
              "field": "p_value",
              "label": "One-sided p"
            },
            {
              "field": "repeats",
              "label": "Permutations"
            },
            {
              "field": "strata",
              "label": "Strata"
            }
          ],
          "rows": [
            {
              "labels": "posterior",
              "observed_gain": 0.001169,
              "null_mean_gain": 0.00115,
              "p_value": 0.474263,
              "repeats": 2000,
              "strata": 14
            },
            {
              "labels": "count_only",
              "observed_gain": 0.003115,
              "null_mean_gain": 0.00384,
              "p_value": 0.726637,
              "repeats": 2000,
              "strata": 14
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "Aggregated finalized audit evidence."
          },
          "methods": [
            {
              "language": "calculation",
              "code": "Gain = MSE(sequence neighborhood) − MSE(3D neighborhood).\nFor each permutation, the complete count/posterior record and target label move together within source-origin × count-bin strata. The prior, geometry and weights remain fixed."
            }
          ]
        }
      ]
    },
    {
      "id": "crossgene-audit",
      "title": "All five genes reproduce algebraically, with varying prior retention",
