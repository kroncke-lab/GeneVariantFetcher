  "schemaVersion": 1,
  "items": [
    {
      "id": "brca2-coverage",
      "title": "BRCA2 coverage increased from 127 to 6,326 variants",
      "queries": [
        {
          "id": "coverage",
          "source": {
            "label": "BRCA2 frozen-to-corrected comparison",
            "files": [
              {
                "label": "old_vs_new.csv.gz"
              },
              {
                "label": "BRCA2/sensitivity.csv"
              }
            ],
            "caveats": [
              "The 6,651-variant all-unresolved polymer result is a broader sensitivity, not the primary. Missing geometry is not a zero score."
            ]
          },
          "summary": "The primary adds canonical polymer contexts and local AlphaFold geometry; 330 of 6,656 variants remain unavailable.",
          "columns": [
            {
              "field": "analysis",
              "label": "Analysis"
            },
            {
              "field": "supported",
              "label": "Supported variants"
            },
            {
              "field": "unavailable",
              "label": "Unavailable variants"
            }
          ],
          "rows": [
            {
              "analysis": "Frozen domain geometry",
              "supported": 127,
              "unavailable": 6529
            },
            {
              "analysis": "Corrected primary",
              "supported": 6326,
              "unavailable": 330
            },
            {
              "analysis": "All unresolved polymer sensitivity",
              "supported": 6651,
              "unavailable": 5
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "Aggregated finalized audit evidence."
          }
        },
        {
          "id": "primary-sources",
          "source": {
            "label": "BRCA2 primary geometry assignment",
            "files": [
              {
                "label": "BRCA2_figure_source_counts.csv"
              },
              {
                "label": "BRCA2/geometry_audit.json"
              }
            ],
            "caveats": [
              "Distances do not cross fragment coordinate frames. Low-confidence polymer segments and structured assignments are exclusive; this is geometry coverage, not disease validation."
            ]
          },
          "summary": "The primary assigns 4,389 variants to polymer, 1,810 to local AlphaFold 3D and 127 to experimental 3D.",
          "columns": [
            {
              "field": "source",
              "label": "Geometry source"
            },
            {
              "field": "variants",
              "label": "Variants"
            }
          ],
          "rows": [
            {
              "source": "AF local 3D",
              "variants": 1810
            },
            {
              "source": "Experimental 3D",
              "variants": 127
            },
            {
              "source": "Polymer",
              "variants": 4389
            },
            {
              "source": "Unavailable",
              "variants": 330
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "Aggregated finalized audit evidence."
          }
        }
      ]
    },
    {
      "id": "gck-prior",
      "title": "GCK’s broad score reflects shared priors, counts and smoothing",
      "assumptions": [
        "The accepted gene-by-missense prior and all-gnomAD-carriers-unaffected assumption are held fixed."
      ],
      "queries": [
        {
          "id": "prior",
          "source": {
            "label": "GCK accepted prior and singleton calculation",
            "files": [
              {
                "label": "gck/checks.json"
              },
              {
                "label": "prior_sensitivities_DIAGNOSTIC.csv"
              },
              {
                "label": "count_and_fit_weight_groups.csv"
              }
            ],
            "caveats": [
              "The singleton posterior is a finite-count value, not a lower bound."
            ]
          },
          "summary": "There are 332 singleton units among 634; they supply 1.53% of historical prior-fit weight.",
          "columns": [
            {
              "field": "alpha",
              "label": "Affected α"
            },
            {
              "field": "beta",
              "label": "Unaffected β"
            },
            {
              "field": "prior_mean",
              "label": "Prior mean"
            },
            {
              "field": "strength",
              "label": "Prior strength"
            },
            {
              "field": "unaffected_singleton_posterior",
              "label": "A=0, U=1 posterior"
            }
          ],
          "rows": [
            {
              "alpha": 1.081159,
              "beta": 1.837596,
              "prior_mean": "37.04%",
              "strength": 2.918755,
              "unaffected_singleton_posterior": "27.59%"
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "Aggregated finalized audit evidence."
          },
          "methods": [
            {
              "language": "calculation",
              "code": "n = A + U; S = α + β; μ = α/S; own posterior = (α + A)/(S + n).\nHistorical prior-fit weight w = 1 − 1/(n + 0.01); μ = Σ(w A/n)/Σw; variance = Σ[w(A/n − μ)²]/M, where M is the number of units."
            }
          ]
        },
        {
          "id": "decomposition",
          "source": {
            "label": "GCK exact frozen-weight decomposition",
            "files": [
              {
                "label": "supported_distributions.csv"
              },
              {
                "label": "gck/checks.json"
              }
            ],
            "caveats": [
              "Component means add to the mean score; separate component medians need not add to the median score. Direct prior share is an algebraic share, not causal inflation."
            ],
            "filters": [
              "614 geometry-supported variants; 20 unavailable variants omitted from distributions"
            ]
          },
          "summary": "Across 614 supported variants, the median neighborhood score is 37.41%; the median direct prior share is 60.71%.",
          "columns": [
            {
              "field": "quantity",
              "label": "Quantity"
            },
            {
              "field": "mean",
              "label": "Mean"
            },
            {
              "field": "median",
              "label": "Median"
            }
          ],
          "rows": [
            {
              "quantity": "Neighborhood score",
              "mean": "36.84%",
              "median": "37.41%"
            },
            {
              "quantity": "Raw-count neighborhood",
              "mean": "34.75%",
              "median": "34.91%"
            },
            {
              "quantity": "Prior retention",
              "mean": "59.64%",
              "median": "60.65%"
            },
            {
              "quantity": "Direct prior component",
              "mean": "22.09%",
              "median": "22.46%"
            },
            {
              "quantity": "Affected-count component",
              "mean": "14.75%",
              "median": "14.65%"
            },
            {
              "quantity": "Direct prior share of score",
              "mean": "62.16%",
              "median": "60.71%"
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "Aggregated finalized audit evidence."
          },
          "methods": [
            {
              "language": "calculation",
              "code": "D = μ × Σ[W S/(S+n)] + Σ[W A/(S+n)].\nRaw-count neighborhood = Σ[W A/n]. W is the saved normalized neighborhood weight with zero target-variant self-weight.\nA constant prior-only donor label yields μ everywhere supported."
            }
          ]
        }
      ]
    },
