          "methods": [
            {
              "language": "calculation",
              "code": "posterior = Beta(alpha_missense + affected, beta_missense + literature_unaffected + gnomAD_carriers); kernel(d) = 2 / (1 + exp(log(3) * d / 3)); density_i = weighted mean of posterior_j for j != i"
            }
